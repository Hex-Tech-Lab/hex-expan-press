# Template only — copy the lines you need into web/.env.local (gitignored) and uncomment.
# Values never go in this file.
# Public client token for @paddle/paddle-js (initializePaddle) — safe for the browser
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Which Paddle environment the client-side checkout initializes against
# NEXT_PUBLIC_PADDLE_ENVIRONMENT=   # sandbox | production
# Server-side Paddle API key (@paddle/paddle-node-sdk) — never expose to the browser
# PADDLE_API_KEY=
# Secret used to verify Paddle webhook signatures (`ts=..;h1=..` scheme)
# PADDLE_WEBHOOK_SECRET=
# PADDLE_ENVIRONMENT=   # server-side: sandbox | production (must be production on Vercel production)
# PADDLE_PRICE_MAP=   # server-side JSON: {"pri_...":"<internal product id>"}
