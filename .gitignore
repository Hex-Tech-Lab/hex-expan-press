.env
node_modules/
data/
*.log
ideabrowser_vault.json

# IP: generated/authored book output and layout source never go to the public repo, full stop
# (Rule #0). data/ above already catches releases/; these are the belt-and-suspenders global
# rules so no future *.pdf or *.typ anywhere in the tree is ever tracked by accident.
*.pdf
*.typ

# Raw capture media (multi-GB video/audio) — never belongs in git, regenerable via yt-dlp/transcribe.ts
downloads/
*.part
*.ytdl

# Pipeline-generated machine artifact (GLM output, consumed by score.ts) — not source, regenerated per run
candidates.json

# Compiled Typst output — regenerable from .typ source, don't track binaries
typst_prototype/*.pdf

# Strategic/confidential decision ledger (Rule #0: never in the public repo)
.memory/
adr/

.playwright-mcp/
.sourcerer/

# Strategic/confidential — local only, never public (CLAUDE.md Rule #0)
docs/council/
docs/compliance/
docs/creator-lifecycle-and-samples.md
docs/infra-cost-registry.md
docs/infra-cost-registry.html

# Agent dispatch prompts + session handovers — contain pricing/strategy and founder prompts (Rule #0)
docs/agent-prompts/
docs/THOS_*.md

# Duane book text (paid product, source + chapter drafts) — local only, never public (Rule #0)
# Superseded by typst_prototype/_archive/ below (ADR 0037/0041); kept for older working trees.
typst_prototype/duane_*.typ
typst_prototype/chapters/

# Current Pandoc-first manuscript (ADR 0037) — the live paid book text + its layout template.
# manuscript.md is the actual book content (Rule #0, never public); template.typ is gitignored
# alongside it out of caution even though it's layout-only, since it's specifically tuned for
# this paid product (Comfort Print, ADR 0039) rather than generic scaffolding.
manuscript/book/manuscript.md
manuscript/book/template.typ

# Legacy/prototype Typst manuscripts, archived 2026-09-22 (ADR 0037/0041, Pandoc-first is final).
# Active path only ever has fonts/, fonts_variable/, img_v3/ plus the ephemeral build.typ
# generated by scripts/book_build.sh — never a hand-authored .typ.
typst_prototype/_archive/
manuscript/book/build.typ

# Pinned external binaries (see docs/TECH_FREEZE.md); re-fetch by digest, never commit
.tools/

# THOS handovers and templates - contain pricing/strategy/session internals (Rule #0)
docs/history/
docs/templates/
manuscript/book/design_rules.json
scripts/__pycache__/

# photo-search candidates and agent scratch (not book assets)
typst_prototype/img_v3/_search/
/parse_*.py
/scratch_box_analysis.py
manuscript/book/cover_data.json

# Book photos (incl. founder/Gemini images) — never newly tracked; public repo (blind-spot audit 2026-09-25)
typst_prototype/img_v3/
manuscript/book/img_v3
# Stray agent scratch scripts at repo root
/test_parse_*.py
